{"item_uid": "指考94-geography-010", "sitting": "regular", "exam_system": "指考", "year_roc": 94, "year_ce": 2005, "subject_key": "geography", "subject_zh": "地理", "curriculum": "99課綱及以前", "number": 10, "join_excluded": false, "part": "第壹部分：選擇題(佔76分)", "stem": "當台灣北部的颱風環流是西北-東南流向時，氣流可沿淡水河進入\n台北盆地，並在盆地南部沿山抬升，造成特大風雨，稱為「西北\n颱」。這種現象應是下列哪種路徑颱風所造成的？", "options": {"A": "1", "B": "2", "C": "4", "D": "5 圖1"}, "option_source": null, "group_id": "8-10", "group_passage": null, "section": null, "keys": "B", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 59.0, "B": 6.0, "C": 10.0, "D": 17.0}, "option_dist_H": {"A": 73.0, "B": 2.0, "C": 12.0, "D": 10.0}, "option_dist_L": {"A": 43.0, "B": 11.0, "C": 8.0, "D": 25.0}, "omit_rate": 8.0, "p_value": 59.0, "p_high": 73.0, "p_low": 43.0, "discrimination": 30.0, "p_quintiles": [77.0, 68.0, 61.0, 53.0, 38.0], "hl_definition": "top_bottom_33pct"}
