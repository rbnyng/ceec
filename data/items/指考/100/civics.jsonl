{"item_uid": "指考100-civics-001", "sitting": "regular", "exam_system": "指考", "year_roc": 100, "year_ce": 2011, "subject_key": "civics", "subject_zh": "公民與社會", "curriculum": "99課綱及以前", "number": 1, "join_excluded": false, "part": null, "stem": "針對報上一篇評論：「接納同性戀將造成生育率下降，不利社會生產」，某知名同志作家為文抗議，\n指出這是一種歧視的言論。請問下列哪一項是判斷同性戀的標準？", "options": {"A": "性徵（sex character）", "B": "性傾向（sexual orientation）", "C": "生物性別（sex）", "D": "社會性別（gender）"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "B", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 1.0, "B": 88.0, "C": 5.0, "D": 5.0}, "option_dist_H": {"A": 0.0, "B": 95.0, "C": 3.0, "D": 2.0}, "option_dist_L": {"A": 2.0, "B": 81.0, "C": 7.0, "D": 9.0}, "omit_rate": 0.0, "p_value": 88.0, "p_high": 95.0, "p_low": 81.0, "discrimination": 14.0, "p_quintiles": [96.0, 92.0, 89.0, 86.0, 79.0], "hl_definition": "top_bottom_33pct"}
