{"item_uid": "指考93-history-001", "sitting": "regular", "exam_system": "指考", "year_roc": 93, "year_ce": 2004, "subject_key": "history", "subject_zh": "歷史", "curriculum": "99課綱及以前", "number": 1, "join_excluded": false, "part": "第壹部分：選擇題（佔80分）", "stem": "台灣許多㆟㈴為「太郎」、「次郎」或是「敏郎」等，這些㆟如此命㈴之背景為何？", "options": {"A": "唐㈹對㆟多以「郎」稱之，台灣沿襲此傳統，亦稱㆟曰「郎」", "B": "繼承清㈹閩南㆞區的習俗，年輕㊚子稱「郎」，㊛子稱「娘」", "C": "㈰本殖民統治初期的暫時現象，㈲㆟積極㈰化便以「郎」㉂稱", "D": "應該是皇民化時期受到㈰本政府鼓勵，以㈰本方式爲子㊛命㈴"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "C", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 7.0, "B": 3.0, "C": 81.0, "D": 7.0, "E": 0.0}, "option_dist_H": {"A": 0.0, "B": 0.0, "C": 3.0, "D": 96.0, "E": 0.0}, "option_dist_L": {"A": 1.0, "B": 3.0, "C": 23.0, "D": 71.0, "E": 0.0}, "omit_rate": 1.0, "p_value": 86.0, "p_high": 96.0, "p_low": 71.0, "discrimination": 25.0, "p_quintiles": [97.0, 95.0, 92.0, 85.0, 63.0], "hl_definition": "top_bottom_33pct"}
{"item_uid": "指考93-history-002", "sitting": "regular", "exam_system": "指考", "year_roc": 93, "year_ce": 2004, "subject_key": "history", "subject_zh": "歷史", "curriculum": "99課綱及以前", "number": 2, "join_excluded": false, "part": "第壹部分：選擇題（佔80分）", "stem": "㆒篇文告指出：賊㆟焚燒㈻宮，破壞孔子神主牌，所到之處，佛寺、道觀、城隍廟、㈳稷壇，\n均遭焚毀。所以號召㈲識之士起來討伐。這篇文告提到的「賊」，最可能是指：", "options": {"A": "元末的白蓮教徒", "B": "明朝末年的流寇", "C": "清末的太平㆝國", "D": "㆓㈩世紀初的㆗共"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "D", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 2.0, "B": 5.0, "C": 29.0, "D": 58.0, "E": 0.0}, "option_dist_H": {"A": 1.0, "B": 0.0, "C": 95.0, "D": 4.0, "E": 0.0}, "option_dist_L": {"A": 18.0, "B": 7.0, "C": 62.0, "D": 10.0, "E": 0.0}, "omit_rate": 6.0, "p_value": 81.0, "p_high": 95.0, "p_low": 62.0, "discrimination": 33.0, "p_quintiles": [97.0, 92.0, 87.0, 77.0, 53.0], "hl_definition": "top_bottom_33pct"}
{"item_uid": "指考93-history-003", "sitting": "regular", "exam_system": "指考", "year_roc": 93, "year_ce": 2004, "subject_key": "history", "subject_zh": "歷史", "curriculum": "99課綱及以前", "number": 3, "join_excluded": false, "part": "第壹部分：選擇題（佔80分）", "stem": "源㉂㊞度的佛教，教義內容廣泛，主要包括大乘、小乘兩大教派。當佛教傳入㆗國，且經過「佛\n教㆗國化」之後，㆗國㈳會普遍流行的是大乘教義。對於這個現象，以㆘解釋何者較為合理？", "options": {"A": "㊞度佛教裡大乘的勢力較大，影響所及，使㆗國也接受大乘佛教", "B": "大乘佛教流傳於㊞度㆖層㈳會，傳入㆗國後，才為㆗國君主接受", "C": "小乘佛教講求渡化個㆟，而大乘強調忠君，所以受㆗國君主歡迎", "D": "大乘佛教的主張與㆗國士㆟理念較相合，所以㆗國選擇大乘義理"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "A", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 54.0, "B": 12.0, "C": 24.0, "D": 6.0, "E": 0.0}, "option_dist_H": {"A": 1.0, "B": 2.0, "C": 14.0, "D": 81.0, "E": 0.0}, "option_dist_L": {"A": 4.0, "B": 10.0, "C": 41.0, "D": 35.0, "E": 0.0}, "omit_rate": 4.0, "p_value": 58.0, "p_high": 81.0, "p_low": 35.0, "discrimination": 46.0, "p_quintiles": [86.0, 71.0, 57.0, 44.0, 31.0], "hl_definition": "top_bottom_33pct"}
{"item_uid": "指考93-history-004", "sitting": "regular", "exam_system": "指考", "year_roc": 93, "year_ce": 2004, "subject_key": "history", "subject_zh": "歷史", "curriculum": "99課綱及以前", "number": 4, "join_excluded": false, "part": "第壹部分：選擇題（佔80分）", "stem": "㆒位歷史㆟物曾獲得這樣的評價：「他將歷史推往現㈹，他的㆝才與歷史的建設性力量合而為\n㆒；德意志和義大利的統㆒、民主㉂由政治的確立未必是他的本意，但這些事件皆得益於他的\n行動。」這位歷史㆟物應該是指㆘列何㆟？", "options": {"A": "拿破崙", "B": "梅㈵涅", "C": "俾斯麥", "D": "加富爾"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "C", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 20.0, "B": 18.0, "C": 18.0, "D": 30.0, "E": 0.0}, "option_dist_H": {"A": 77.0, "B": 6.0, "C": 13.0, "D": 2.0, "E": 0.0}, "option_dist_L": {"A": 33.0, "B": 16.0, "C": 33.0, "D": 9.0, "E": 0.0}, "omit_rate": 13.0, "p_value": 54.0, "p_high": 77.0, "p_low": 33.0, "discrimination": 44.0, "p_quintiles": [83.0, 67.0, 51.0, 40.0, 30.0], "hl_definition": "top_bottom_33pct"}
