{"item_uid": "學測101-math-013", "sitting": "regular", "exam_system": "學測", "year_roc": 101, "year_ce": 2012, "subject_key": "math", "subject_zh": "數學", "curriculum": "99課綱及以前", "number": 13, "join_excluded": false, "part": "第壹部分：選擇題（占65分）", "stem": "平面上兩點F,F 滿足FF 4。設d 為一實數，令表示平面上滿足 PF PF d 的所有P\n1 2 1 2 1 2\n點所成的圖形，又令C為平面上以F 為圓心、6為半徑的圓。請問下列哪些選項是正確的？\n1\n(1) 當d 0時，為直線\n(2) 當d 1時，為雙曲線\n(3) 當d 2時，與圓C交於兩點\n(4) 當d 4時，與圓C交於四點\n(5) 當d 8時，不存在", "options": {}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "1,2,5", "item_flags": [], "extracted_by": "pdf", "multi_select": true, "option_dist_T": {"1": 71.0, "2": 76.0, "3": 38.0, "4": 36.0, "5": 64.0}, "option_dist_H": {"1": 92.0, "2": 95.0, "3": 10.0, "4": 16.0, "5": 84.0}, "option_dist_L": {"1": 49.0, "2": 57.0, "3": 62.0, "4": 48.0, "5": 44.0}, "omit_rate": 0.0, "p_value": 45.0, "p_high": 79.0, "p_low": 16.0, "discrimination": 63.0, "p_quintiles": [87.0, 62.0, 38.0, 23.0, 13.0], "hl_definition": "top_bottom_33pct"}
