{"item_uid": "指考93-biology-040", "sitting": "regular", "exam_system": "指考", "year_roc": 93, "year_ce": 2004, "subject_key": "biology", "subject_zh": "生物", "curriculum": "99課綱及以前", "number": 40, "join_excluded": false, "part": null, "stem": "若要使卵巢被摘除掉的雌鼠重現動情週期，則應對該雌鼠補充㆘列哪些激素？（多選）", "options": {"A": "睪固酮", "B": "動情素", "C": "黃體素(助孕素)", "D": "催產素", "E": "抗利尿激素"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "BC", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 14.0, "B": 13.0, "C": 5.0, "D": 65.0, "E": 0.0}, "option_dist_H": {"A": 3.0, "B": 98.0, "C": 94.0, "D": 19.0, "E": 3.0}, "option_dist_L": {"A": 7.0, "B": 67.0, "C": 42.0, "D": 77.0, "E": 43.0}, "omit_rate": 4.0, "p_value": 50.0, "p_high": 87.0, "p_low": 12.0, "discrimination": 75.0, "p_quintiles": [93.0, 74.0, 50.0, 26.0, 6.0], "hl_definition": "top_bottom_33pct"}
{"item_uid": "指考93-biology-041", "sitting": "regular", "exam_system": "指考", "year_roc": 93, "year_ce": 2004, "subject_key": "biology", "subject_zh": "生物", "curriculum": "99課綱及以前", "number": 41, "join_excluded": false, "part": null, "stem": "假如在雌鼠初次交配前，預先投予可促進 ADH 作用的藥物，將會對雌鼠交配後之配對行為產生何種影\n響？（單選）", "options": {"A": "會促進其配對行為的產生", "B": "會抑制其配對行為的產生", "C": "會破壞已建立的配對行為", "D": "應不會影響雌鼠的配對行為\n肆、非選擇題（30 %）"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "D", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": null, "option_dist_H": {"A": 6.0, "B": 5.0, "C": 1.0, "D": 88.0, "E": 0.0}, "option_dist_L": {"A": 23.0, "B": 24.0, "C": 12.0, "D": 37.0, "E": 0.0}, "omit_rate": null, "p_value": 64.0, "p_high": 88.0, "p_low": 35.0, "discrimination": 53.0, "p_quintiles": [91.0, 80.0, 69.0, 54.0, 26.0], "hl_definition": "top_bottom_33pct"}
