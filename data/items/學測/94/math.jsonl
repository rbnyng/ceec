{"item_uid": "學測94-math-001", "sitting": "regular", "exam_system": "學測", "year_roc": 94, "year_ce": 2005, "subject_key": "math", "subject_zh": "數學", "curriculum": "99課綱及以前", "number": 1, "join_excluded": false, "part": null, "stem": "試問整數43659共有多少個不同的質因數？\n(1) 1個 (2) 2個 (3) 3個 (4) 4個 (5) 5個\nn(n+1)", "options": {}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "C（或A）", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"1": 2.0, "2": 9.0, "3": 73.0, "4": 12.0, "5": 4.0}, "option_dist_H": {"1": 0.0, "2": 3.0, "3": 91.0, "4": 5.0, "5": 1.0}, "option_dist_L": {"1": 4.0, "2": 17.0, "3": 50.0, "4": 21.0, "5": 8.0}, "omit_rate": 0.0, "p_value": 73.0, "p_high": 91.0, "p_low": 50.0, "discrimination": 41.0, "p_quintiles": [93.0, 86.0, 79.0, 65.0, 42.0], "hl_definition": "top_bottom_33pct"}
