{"item_uid": "分科114-chemistry-010", "sitting": "regular", "exam_system": "分科", "year_roc": 114, "year_ce": 2025, "subject_key": "chemistry", "subject_zh": "化學", "curriculum": "108課綱", "number": 10, "join_excluded": false, "part": "第壹部分、選擇題（占76分）", "stem": "甲、乙、丙、丁、戊五種元素的原子序均小於20。甲是週期表中質量最小的元素，乙是週期表中電負度最大的元素，丙原子最外殼層電子數是次外殼層電子數的三倍，丁原子序大於丙，而且丁與丙為同一族，另外，戊和乙的原子序總和等於丙和丁原子序總和。下列敘述哪些正確？", "options": {"A": "甲與乙形成的化合物不溶於水", "B": "在自然界中的丙有兩種同位素", "C": "甲與丙反應後所得的化合物，可形成分子間氫鍵", "D": "丁在常溫下為黃色固體", "E": "戊的氧化物溶於水呈酸性"}, "option_source": "inline", "group_id": null, "group_passage": null, "section": "說明：第8題至第19題，每題4分。", "keys": "CDE", "item_flags": [], "extracted_by": "docx", "multi_select": true, "option_dist_T": {"A": 18.0, "B": 49.0, "C": 84.0, "D": 78.0, "E": 68.0}, "option_dist_H": {"A": 2.0, "B": 43.0, "C": 96.0, "D": 92.0, "E": 84.0}, "option_dist_L": {"A": 37.0, "B": 55.0, "C": 73.0, "D": 62.0, "E": 53.0}, "omit_rate": 0.0, "p_value": 51.0, "p_high": 72.0, "p_low": 29.0, "discrimination": 43.0, "p_quintiles": [76.0, 65.0, 53.0, 38.0, 24.0], "hl_definition": "top_bottom_33pct"}
{"item_uid": "分科114-chemistry-011", "sitting": "regular", "exam_system": "分科", "year_roc": 114, "year_ce": 2025, "subject_key": "chemistry", "subject_zh": "化學", "curriculum": "108課綱", "number": 11, "join_excluded": false, "part": "第壹部分、選擇題（占76分）", "stem": "某生配製濃度均為1.0 M的、、與四種水溶液後，忘記標示，致使無法辨識各溶液。為能得知各溶液成分，他先將溶液標示為：甲、乙、丙、丁，再從中分別多次取出1.0 mL，兩兩混合，所得實驗結果記錄如下：", "options": {"A": "甲為", "B": "乙為", "C": "丙為", "D": "丁為", "E": "若於丁溶液中加入KI水溶液，則會產生沉澱"}, "option_source": "inline", "group_id": null, "group_passage": null, "section": "說明：第8題至第19題，每題4分。", "keys": "ADE", "item_flags": [], "extracted_by": "docx", "multi_select": true, "option_dist_T": {"A": 65.0, "B": 38.0, "C": 30.0, "D": 69.0, "E": 73.0}, "option_dist_H": {"A": 87.0, "B": 13.0, "C": 10.0, "D": 83.0, "E": 88.0}, "option_dist_L": {"A": 45.0, "B": 60.0, "C": 50.0, "D": 57.0, "E": 59.0}, "omit_rate": 1.0, "p_value": 47.0, "p_high": 78.0, "p_low": 20.0, "discrimination": 58.0, "p_quintiles": [85.0, 64.0, 43.0, 27.0, 16.0], "hl_definition": "top_bottom_33pct"}
