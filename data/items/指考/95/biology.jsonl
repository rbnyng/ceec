{"item_uid": "指考95-biology-045", "sitting": "regular", "exam_system": "指考", "year_roc": 95, "year_ce": 2006, "subject_key": "biology", "subject_zh": "生物", "curriculum": "99課綱及以前", "number": 45, "join_excluded": false, "part": "第壹部分：選擇題(佔76分)", "stem": "下列哪些作法對於瘧疾的預防或治療有幫助？(多選)", "options": {"A": "尋找廣效性的ACC抑制劑", "B": "鑑定端複胞器的專一基因", "C": "研究端複胞器蛋白質的活性位置", "D": "利用基因重組技術增進人類脂肪酸代謝速率", "E": "降低蚊蟲在人類活動空間的出現頻率\n- 6 -\n第 7 頁 95年指考\n共 7 頁 生物考科"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "BCE", "item_flags": [], "extracted_by": "pdf", "multi_select": true, "option_dist_T": {"A": 70.0, "B": 71.0, "C": 73.0, "D": 21.0, "E": 60.0}, "option_dist_H": {"A": 67.0, "B": 88.0, "C": 87.0, "D": 8.0, "E": 76.0}, "option_dist_L": {"A": 72.0, "B": 53.0, "C": 56.0, "D": 35.0, "E": 45.0}, "omit_rate": 8.0, "p_value": 27.0, "p_high": 51.0, "p_low": 2.0, "discrimination": 49.0, "p_quintiles": [56.0, 40.0, 28.0, 14.0, -4.0], "hl_definition": "top_bottom_33pct"}
