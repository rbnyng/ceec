{"item_uid": "學測93-math-009", "sitting": "regular", "exam_system": "學測", "year_roc": 93, "year_ce": 2004, "subject_key": "math", "subject_zh": "數學", "curriculum": "99課綱及以前", "number": 10, "join_excluded": false, "part": null, "stem": "從1,2,…,10這十個數中隨意取兩個，以p表示其和為偶數之機率，q表示其和為奇數之機率。\n試問下列哪些敘述是正確的？\n1 1 1\n(1) p＋q＝1 (2) p＝q (3) p−q ≤ (4) p−q ≥ (5) p≥\n10 20 2", "options": {}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "D", "item_flags": [], "extracted_by": "pdf", "multi_select": true, "option_dist_T": {"A": 74.0, "B": 31.0, "C": 30.0, "D": 64.0, "E": 37.0}, "option_dist_H": {"A": 92.0, "B": 9.0, "C": 12.0, "D": 87.0, "E": 17.0}, "option_dist_L": {"A": 53.0, "B": 53.0, "C": 48.0, "D": 42.0, "E": 54.0}, "omit_rate": 0.0, "p_value": 43.0, "p_high": 77.0, "p_low": 12.0, "discrimination": 65.0, "p_quintiles": [84.0, 62.0, 41.0, 21.0, 8.0], "hl_definition": "top_bottom_33pct"}
