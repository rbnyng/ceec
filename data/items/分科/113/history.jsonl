{"item_uid": "分科113-history-025", "sitting": "regular", "exam_system": "分科", "year_roc": 113, "year_ce": 2024, "subject_key": "history", "subject_zh": "歷史", "curriculum": "108課綱", "number": 25, "join_excluded": false, "part": "第壹部分、選擇題（占72分）", "stem": "總督府委託伊能嘉矩進行全臺灣踏查，最主要目的應是：", "options": {"A": "純為對臺灣原住民族進行族群分類", "B": "理解漢人與原住民族風俗習慣異同", "C": "進行「蕃」地探險以調查土地產權", "D": "瞭解「蕃」地實情以制訂治理政策"}, "option_source": "inline", "group_id": "25-26", "group_passage": "臺灣總督府委託伊能嘉矩進行臺灣踏查。伊能嘉矩於1897年11月的「踏查日記」，記載他到大庄（今花蓮富里鄉東里村）聽一位名叫Taoren的老人說：我們平埔人最初住在前山舊鳳山縣，受到客人（移入的漢人）壓迫，不得已推舉族中Poanvura等三人為首，\n帶領族人避到後山的巴塱衛（今臺東大武鄉），然後北上到卑南。在卑南，受到卑南「蕃」欺負，忍受七年後，舉族北遷到璞石閣（今花蓮玉里鎮）南側的大庄定居。", "section": "說明：第1題至第30題，每題2分。", "keys": "D", "item_flags": [], "extracted_by": "docx", "multi_select": false, "option_dist_T": {"A": 9.0, "B": 4.0, "C": 20.0, "D": 67.0}, "option_dist_H": {"A": 6.0, "B": 4.0, "C": 14.0, "D": 77.0}, "option_dist_L": {"A": 11.0, "B": 6.0, "C": 27.0, "D": 56.0}, "omit_rate": 0.0, "p_value": 67.0, "p_high": 77.0, "p_low": 56.0, "discrimination": 21.0, "p_quintiles": [80.0, 72.0, 68.0, 64.0, 51.0], "hl_definition": "top_bottom_33pct"}
