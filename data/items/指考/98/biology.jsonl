{"item_uid": "指考98-biology-005", "sitting": "regular", "exam_system": "指考", "year_roc": 98, "year_ce": 2009, "subject_key": "biology", "subject_zh": "生物", "curriculum": "99課綱及以前", "number": 5, "join_excluded": false, "part": null, "stem": "龜山島是台灣近海的離島，如果發生火山爆發使島上生物全部消失，但陸地仍存在，則下列哪\n一物種最可能首先棲息在龜山島？", "options": {"A": "麻雀", "B": "蜜蜂", "C": "蕨類植物", "D": "鬼針草（咸豐草）"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "C", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 9.0, "B": 0.0, "C": 58.0, "D": 30.0}, "option_dist_H": {"A": 15.0, "B": 0.0, "C": 49.0, "D": 34.0}, "option_dist_L": {"A": 5.0, "B": 1.0, "C": 66.0, "D": 25.0}, "omit_rate": 2.0, "p_value": 58.0, "p_high": 49.0, "p_low": 66.0, "discrimination": -17.0, "p_quintiles": [47.0, 53.0, 59.0, 64.0, 67.0], "hl_definition": "top_bottom_33pct"}
{"item_uid": "指考98-biology-006", "sitting": "regular", "exam_system": "指考", "year_roc": 98, "year_ce": 2009, "subject_key": "biology", "subject_zh": "生物", "curriculum": "99課綱及以前", "number": 6, "join_excluded": false, "part": null, "stem": "在實驗室中利用定量培養基來培養某蠅類時，其幼蟲數\n目與羽化為成蠅數目的關係如圖1。試問在培養基中放\n養多少隻幼蟲時，其存活率超過50%？", "options": {"A": "30隻", "B": "40隻", "C": "50隻\n圖1", "D": "60隻"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "A", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 96.0, "B": 1.0, "C": 1.0, "D": 1.0}, "option_dist_H": {"A": 100.0, "B": 0.0, "C": 0.0, "D": 0.0}, "option_dist_L": {"A": 90.0, "B": 2.0, "C": 2.0, "D": 2.0}, "omit_rate": 2.0, "p_value": 96.0, "p_high": 100.0, "p_low": 90.0, "discrimination": 10.0, "p_quintiles": [100.0, 99.0, 99.0, 97.0, 86.0], "hl_definition": "top_bottom_33pct"}
