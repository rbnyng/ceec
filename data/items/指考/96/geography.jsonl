{"item_uid": "指考96-geography-023", "sitting": "regular", "exam_system": "指考", "year_roc": 96, "year_ce": 2007, "subject_key": "geography", "subject_zh": "地理", "curriculum": "99課綱及以前", "number": 23, "join_excluded": false, "part": null, "stem": "關於澳洲農業發展的條件，哪些正確？\n甲、位於馬緯度無風帶，氣候乾燥，促成粗放的畜牧業\n乙、降水的分布明顯受到山脈和東北季風之影響\n丙、冷凍科技革新，促成畜牧產品的大量輸出\n丁、南北半球的農產供應與市場需求具季節互補性\n戊、原住民的傳統知識大幅提升農產附加價值", "options": {"A": "甲乙戊", "B": "甲丙丁", "C": "乙丙丁", "D": "丙丁戊"}, "option_source": null, "group_id": "21-23", "group_passage": null, "section": null, "keys": "B", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 2.0, "B": 53.0, "C": 34.0, "D": 6.0}, "option_dist_H": {"A": 0.0, "B": 71.0, "C": 23.0, "D": 5.0}, "option_dist_L": {"A": 5.0, "B": 37.0, "C": 41.0, "D": 6.0}, "omit_rate": 5.0, "p_value": 53.0, "p_high": 71.0, "p_low": 37.0, "discrimination": 34.0, "p_quintiles": [77.0, 60.0, 50.0, 42.0, 35.0], "hl_definition": "top_bottom_33pct"}
{"item_uid": "指考96-geography-024", "sitting": "regular", "exam_system": "指考", "year_roc": 96, "year_ce": 2007, "subject_key": "geography", "subject_zh": "地理", "curriculum": "99課綱及以前", "number": 24, "join_excluded": false, "part": null, "stem": "關於尼羅河的敘述，下列何者正確？ 亞斯文 (cid:81)\n納塞湖", "options": {"A": "上游接近赤道，位於乾旱炎熱區", "B": "高壩湖區地處埃及和衣索比亞之交界", "C": "紅海阻隔自古即與西亞互不往來", "D": "集水區水資源分配成為國際問題"}, "option_source": null, "group_id": "24-26", "group_passage": null, "section": null, "keys": "D", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 15.0, "B": 18.0, "C": 2.0, "D": 49.0}, "option_dist_H": {"A": 14.0, "B": 15.0, "C": 1.0, "D": 65.0}, "option_dist_L": {"A": 15.0, "B": 21.0, "C": 5.0, "D": 32.0}, "omit_rate": 16.0, "p_value": 49.0, "p_high": 65.0, "p_low": 32.0, "discrimination": 33.0, "p_quintiles": [70.0, 57.0, 48.0, 41.0, 28.0], "hl_definition": "top_bottom_33pct"}
