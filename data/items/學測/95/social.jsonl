{"item_uid": "學測95-social-007", "sitting": "regular", "exam_system": "學測", "year_roc": 95, "year_ce": 2006, "subject_key": "social", "subject_zh": "社會", "curriculum": "99課綱及以前", "number": 7, "join_excluded": false, "part": "第壹部分(佔84分)", "stem": "全球化的浪潮席捲全世界，某些強勢文化挾帶經濟和科技的優勢，向全球進行「文\n化傾銷」，有些國家因而遭遇了本土文化式微甚至消失的危機。本土文化遭逢全\n球化的挑戰，這與清末民初中山先生認為中國所遭遇的何種境遇最相似？", "options": {"A": "列強武力侵略壓迫，國家主權淪喪", "B": "列強經濟力的壓迫，外資大舉入侵", "C": "國人放棄民族主義，講求世界主義", "D": "中國科學技術落後，產業發展停頓\n- 1 -\n95學年度 第 2 頁\n社會考科 共 14 頁"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "B", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 28.0, "B": 33.0, "C": 32.0, "D": 6.0}, "option_dist_H": {"A": 20.0, "B": 34.0, "C": 42.0, "D": 4.0}, "option_dist_L": {"A": 34.0, "B": 35.0, "C": 21.0, "D": 10.0}, "omit_rate": 0.0, "p_value": 32.0, "p_high": 42.0, "p_low": 21.0, "discrimination": 21.0, "p_quintiles": [44.0, 38.0, 33.0, 27.0, 18.0], "hl_definition": "top_bottom_33pct"}
