{"item_uid": "學測102-chinese-005", "sitting": "regular", "exam_system": "學測", "year_roc": 102, "year_ce": 2013, "subject_key": "chinese", "subject_zh": "國文", "curriculum": "99課綱及以前", "number": 5, "join_excluded": false, "part": "第壹部分：選擇題（占54分）", "stem": "下列是一段評論〈擣衣〉詩的 文字，依文意選出排列順序最恰當的選項：\n〈擣衣〉清而徹，有悲人者。此是\n甲、內外相感，愁情結悲 乙、秋士悲於心\n丙、然後哀怨生焉 丁、擣衣感於外\n苟無感，何嗟何怨也！（蕭繹《金樓子．立言篇》）", "options": {"A": "乙丙丁甲", "B": "乙丁甲丙", "C": "丁甲乙丙", "D": "丁丙乙甲\n- 1 -\n102年學測 第 2 頁\n國文考科 共 7 頁"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": "B", "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 13.0, "B": 72.0, "C": 9.0, "D": 6.0}, "option_dist_H": {"A": 5.0, "B": 89.0, "C": 3.0, "D": 3.0}, "option_dist_L": {"A": 21.0, "B": 52.0, "C": 17.0, "D": 10.0}, "omit_rate": 0.0, "p_value": 72.0, "p_high": 89.0, "p_low": 52.0, "discrimination": 37.0, "p_quintiles": [91.0, 83.0, 74.0, 64.0, 45.0], "hl_definition": "top_bottom_33pct"}
