{"item_uid": "學測86-science-052", "sitting": "regular", "exam_system": "學測", "year_roc": 86, "year_ce": 1997, "subject_key": "science", "subject_zh": "自然", "curriculum": "99課綱及以前", "number": 53, "join_excluded": false, "part": null, "stem": "通電流的導線在磁場中會受到力的作用。設電流為 I ，磁場為 B。作用力為\nv uv v\nF 。 B與 F 互相垂直。下列各圖所表不的情形，那一種正可能真正發生的情\n形？", "options": {"A": "", "B": "", "C": "", "D": "-11-\n自然考科 第 12 頁\n共 14 頁"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": null, "item_flags": [], "extracted_by": "pdf"}
