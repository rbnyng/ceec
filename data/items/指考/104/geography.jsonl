{"item_uid": "指考104-geography-001", "sitting": "regular", "exam_system": "指考", "year_roc": 104, "year_ce": 2015, "subject_key": "geography", "subject_zh": "地理", "curriculum": "99課綱及以前", "number": 1, "join_excluded": false, "part": null, "stem": "臺灣某一都市連同周圍鄉鎮人口數約 47 萬，區域內的便利商店有 172 家、量販店有 4 家、\n百貨公司有 3 家。下列哪個概念最適合用來解釋這些零售業的數量分布情形？", "options": {"A": "物流", "B": "商閾", "C": "空間分工", "D": "都市等級大小"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": null, "item_flags": [], "extracted_by": "pdf", "multi_select": false, "option_dist_T": {"A": 1.0, "B": 86.0, "C": 2.0, "D": 10.0}, "option_dist_H": {"A": 0.0, "B": 93.0, "C": 0.0, "D": 6.0}, "option_dist_L": {"A": 2.0, "B": 78.0, "C": 5.0, "D": 15.0}, "omit_rate": 0.0, "p_value": 86.0, "p_high": 93.0, "p_low": 78.0, "discrimination": 15.0, "p_quintiles": [95.0, 90.0, 88.0, 85.0, 73.0], "hl_definition": "top_bottom_33pct"}
