{"item_uid": "學測83-science-024", "sitting": "regular", "exam_system": "學測", "year_roc": 83, "year_ce": 1994, "subject_key": "science", "subject_zh": "自然", "curriculum": "99課綱及以前", "number": 24, "join_excluded": false, "part": null, "stem": "清潔劑的分子常有親油性及親水性兩種官能基團，所以可將油污溶解於水中。試問\n清潔劑的分子通常是何種形狀", "options": {"A": "球形", "B": "環形", "C": "長鏈形", "D": "立方體形"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": null, "item_flags": [], "extracted_by": "pdf"}
{"item_uid": "學測83-science-025", "sitting": "regular", "exam_system": "學測", "year_roc": 83, "year_ce": 1994, "subject_key": "science", "subject_zh": "自然", "curriculum": "99課綱及以前", "number": 25, "join_excluded": false, "part": null, "stem": "有關碳與氮在地球上的情形，下列哪一個敘述正確？", "options": {"A": "一氧化碳中的碳，其氧化數在碳的化合物中最高", "B": "大氣中的氮，經由雨水被帶入生物圈中", "C": "腐爛的生物會發臭，是因為分解釋出大量的一氧化碳", "D": "在地殼的石灰岩中含有大量的碳酸鈣"}, "option_source": null, "group_id": null, "group_passage": null, "section": null, "keys": null, "item_flags": [], "extracted_by": "pdf"}
